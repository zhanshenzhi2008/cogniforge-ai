# =====================================================================
# cogniforge-ai 生产环境变量
# cp .env.example .env  # 然后填真实值
# =====================================================================

# ─── 镜像命名空间（CD 自动注入，也可手动覆盖）─────────────
IMAGE_NAMESPACE=zhanshenzhi2008

# ─── Go 后端（LLM 唯一出口）────────────────────────────────
# 生产：与 Go 共用 /opt/project/cogniforge/.env；compose 只 env_file，不写死。
# 生产网络内用服务名；本地开发改为 http://localhost:8080
COGNIFORGE_API_URL=http://cogniforge:8080

# ─── 数据库（公用 pgvector，只存向量，不读 API Key）────────
PGSQL_HOST=pgsql
PGSQL_PORT=5432
PGSQL_USERNAME=postgres
PGSQL_PASSWORD=change_me_to_a_secure_random_password_at_least_16_chars
PGSQL_DB=cogniforge

# ─── Redis（与 Go 共用模型配置缓存 cogniforge:modelcfg:*）────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PWD=

# ─── 服务日志 ────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── 监听（仅本地 start.sh 使用；Docker 镜像 CMD 固定 0.0.0.0:8086）─
# 生产共享 .env 用 COGNIFORGE_PORT=8080（Go），不要写通用 PORT=8086。
# HOST=0.0.0.0
# PORT=8086

# ─── Embedding ───────────────────────────────────────────
# go = 回调 Go /api/v1/embeddings（与模型页同一套供应商）
# local = 本机 sentence-transformers（当前供应商不支持 embeddings 时用）
EMBEDDER_TYPE=go

# ─── LLM API Key 不要写在这里 ────────────────────────────
# 供应商 / 模型 / Key 只在控制台「模型」页配置。
# 请删除：ENCRYPTION_KEY（Python 不再解密 ai_providers）
#         OPENAI_API_KEY  ANTHROPIC_API_KEY  OPENROUTER_API_KEY
#         OPENAI_BASE_URL  DEFAULT_MODEL  OPENROUTER_HTTP_REFERER  OPENROUTER_TITLE
