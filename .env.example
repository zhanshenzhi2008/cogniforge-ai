# =====================================================================
# cogniforge-ai 生产环境变量
# cp .env.example .env  # 然后填真实值
# =====================================================================

# ─── 镜像命名空间（CD 自动注入，也可手动覆盖）─────────────
IMAGE_NAMESPACE=zhanshenzhi2008

# ─── 数据库（公用 ../envs/global-db.env）────────────────────────
PGSQL_HOST=pgsql
PGSQL_PORT=5432
PGSQL_USERNAME=postgres
PGSQL_PASSWORD=change_me_to_a_secure_random_password_at_least_16_chars
PGSQL_DB=cogniforge

# ─── 服务日志 ────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── 与 Go 共用的解密密钥（必须和 cogniforge/.env 的 ENCRYPTION_KEY 一致）──
ENCRYPTION_KEY=change_me_to_a_secure_random_key_at_least_32_chars

# ─── LLM API Key 不要写在这里 ────────────────────────────────
# 供应商 / 模型 / Key 在控制台「模型」页配置，写入 PostgreSQL ai_providers。
# 请删除：OPENAI_API_KEY  ANTHROPIC_API_KEY  OPENROUTER_API_KEY
#         OPENAI_BASE_URL  DEFAULT_MODEL  OPENROUTER_HTTP_REFERER  OPENROUTER_TITLE
